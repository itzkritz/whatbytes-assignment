# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Option 1: Direct Connection URL (recommended for Cloud DB like Neon, Supabase, Render)
# DATABASE_URL=postgresql://user:password@host:5432/healthcare_db?sslmode=require

# Option 2: Individual Local DB Credentials (if running PostgreSQL locally or in Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
